-Login Pseudocode

START
    DISPLAY login form
    Enter email
    Enter password
    IF email or password feild empty THEN
            Display "please complete all feilds"
    ELSE
        Check the login details
        
        IF login details are correct THEN
            Sign in the user
            Display deshboard
        ELSE
            Display "Invalid credentials"
            RETURN to form
        END IF
    END IF
END

-Task Creation Pseudocode

START
    Display task form

    Enter task title
    Enter catergory
    Enter dueDate
    Enter priority

    IF required information is missing
    THEN
        Display "Please complete all required feilds"
    ELSE
        Create a new task

        Save the task

        Display the new task in the task list

        Display "Task created successfully"
    END IF 
    
END

-Progress Calculation Pseudocode

START
FETCH all tasks

IF there are no tasks THEN
        Display "No tasks available"
ELSE
    Count the total number of tasks

    Count the number of completed tasks

    Calculate outstanding tasks

    Calculate progress percentage

    Display total tasks
    Display completed tasks
    Display outstanding tasks
    Display progress percentage

END IF
END
        

-Delete Task Pseudocode

START

Display task list

User selects a task to Delete

Display confirmation dialog: "Are you sure you ant to delete this task? This action cannot be undone"

IF user confirm deletion THEN
    Delete the selected task
    Update the task list
    Display "Task deleted successfully"
ELSE
    Cancel deletion
    Keep the task unchanged

END IF
      
END
    