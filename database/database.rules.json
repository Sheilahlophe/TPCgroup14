{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'assessor')",

        ".write": "auth != null && auth.uid == $uid",

        ".validate": "newData.hasChildren(['email', 'displayName', 'role', 'createdAt'])",

        "role": {
          ".validate": "newData.val() == 'learner' || newData.val() == 'assessor'"
        }
      }
    },

    "tasks": {
      "$taskId": {
        ".read": "auth != null && (data.child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'assessor')",

        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() == auth.uid) || (data.exists() && data.child('userId').val() == auth.uid))",

        ".validate": "newData.hasChildren(['userId', 'title', 'description', 'status', 'createdAt', 'updatedAt'])",

        "status": {
          ".validate": "newData.val() == 'not-completed' || newData.val() == 'completed'"
        }
      }
    },

    "bookings": {
      "$bookingId": {
        ".read": "auth != null && (data.child('userId').val() == auth.uid || data.child('assessorId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'assessor')",

        ".write": "auth != null && (newData.child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'assessor')",

        ".validate": "newData.hasChildren(['userId', 'assessorId', 'preferredDate', 'preferredTime', 'reason', 'status', 'createdAt'])",

        "status": {
          ".validate": "newData.val() == 'pending' || newData.val() == 'approved' || newData.val() == 'rejected'"
        }
      }
    },

    "resources": {
      ".read": "auth != null",

      "$resourceId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'assessor'",

        ".validate": "newData.hasChildren(['title', 'type', 'url', 'description', 'category'])",

        "type": {
          ".validate": "newData.val() == 'document' || newData.val() == 'link' || newData.val() == 'guide'"
        }
      }
    },

    "scores": {
      "$scoreId": {
        ".read": "auth != null && (data.child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'assessor')",

        ".write": "auth != null && newData.child('userId').val() == auth.uid",

        ".validate": "newData.hasChildren(['userId', 'score', 'duration', 'completedAt'])"
      }
    }
  }
}